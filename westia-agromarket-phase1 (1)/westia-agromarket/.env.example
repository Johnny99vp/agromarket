# ---- apps/web/.env  (PUBLIC values only; everything VITE_ ships to the browser) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
VITE_APP_URL=http://localhost:5173

# ---- supabase/functions/.env  (SERVER ONLY - never prefix with VITE_, never commit) ----
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx      # TEST key locally; also used to verify webhook signatures
SITE_URL=http://localhost:5173            # Paystack callback target
# Only if the Farm Manager owner provides a documented, authorized API:
FARM_MANAGER_API_URL=
FARM_MANAGER_API_KEY=
